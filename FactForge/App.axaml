<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FactForge.App"
             xmlns:local="using:FactForge"
             xmlns:conv="using:FactForge.Converters"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <conv:EnumEqualityConverter x:Key="EnumEqualityConverter"/>

            <ResourceDictionary.ThemeDictionaries>
                <!-- Dark Theme Palette -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush">#121921</SolidColorBrush>
                    <SolidColorBrush x:Key="CardBackgroundBrush">#1C2633</SolidColorBrush>
                    <SolidColorBrush x:Key="CardSecondaryBrush">#2B3848</SolidColorBrush>
                    <SolidColorBrush x:Key="HeaderBorderBrush">#253342</SolidColorBrush>
                    <SolidColorBrush x:Key="CardHeaderBorderBrush">#FFFFFF</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="PrimaryTextBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SecondaryTextBrush">#9CA3AF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentTealBrush">#00A8BC</SolidColorBrush>

                    <SolidColorBrush x:Key="DialogBackgroundBrush">#1E1E1E</SolidColorBrush>
                    <SolidColorBrush x:Key="DialogTitleBrush">White</SolidColorBrush>
                    <SolidColorBrush x:Key="DialogTextBrush">#CCCCCC</SolidColorBrush>
                    <SolidColorBrush x:Key="DialogOverlayBrush">#99000000</SolidColorBrush>

                    <!-- TextBox Defaults -->
                    <SolidColorBrush x:Key="TextControlBackground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForeground">#121921</SolidColorBrush>

                    <!-- TextBox Hover State -->
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver">#121921</SolidColorBrush>

                    <!-- TextBox Focused State -->
                    <SolidColorBrush x:Key="TextControlBackgroundFocused">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundFocused">#121921</SolidColorBrush>
                    
                    <!-- Caret and Selection -->
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor">#00A8BC</SolidColorBrush>
                </ResourceDictionary>

                <!-- Light Theme Palette -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush">#F4F6F9</SolidColorBrush>
                    <SolidColorBrush x:Key="CardBackgroundBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="CardSecondaryBrush">#E5E9F0</SolidColorBrush>
                    <SolidColorBrush x:Key="HeaderBorderBrush">#D0D7DE</SolidColorBrush>
                    <SolidColorBrush x:Key="CardHeaderBorderBrush">#BDBDBD</SolidColorBrush>
                    
                    <SolidColorBrush x:Key="PrimaryTextBrush">#121921</SolidColorBrush>
                    <SolidColorBrush x:Key="SecondaryTextBrush">#6B7280</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentTealBrush">#00899A</SolidColorBrush>

                    <SolidColorBrush x:Key="DialogBackgroundBrush">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="DialogTitleBrush">#1A1A1A</SolidColorBrush>
                    <SolidColorBrush x:Key="DialogTextBrush">#555555</SolidColorBrush>
                    <SolidColorBrush x:Key="DialogOverlayBrush">#66000000</SolidColorBrush>

                    <!-- TextBox Defaults -->
                    <SolidColorBrush x:Key="TextControlBackground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForeground">#121921</SolidColorBrush>

                    <!-- TextBox Hover State -->
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundPointerOver">#121921</SolidColorBrush>

                    <!-- TextBox Focused State -->
                    <SolidColorBrush x:Key="TextControlBackgroundFocused">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextControlForegroundFocused">#121921</SolidColorBrush>

                    <!-- Caret and Selection -->
                    <SolidColorBrush x:Key="TextControlSelectionHighlightColor">#00899A</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Default styling for all white input fields -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#121921"/>
        </Style>

        <!-- Border highlight and background preservation on focus -->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTealBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Keep search/inner icon visible on focus -->
        <Style Selector="TextBox:focus /template/ ContentPresenter#PART_InnerLeftContent">
            <Setter Property="Foreground" Value="#666666"/>
        </Style>
    </Application.Styles>
</Application>