<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FactForge.ViewModels"
             x:Class="FactForge.Views.AudioPicker"
             x:DataType="vm:SlideAudioEditorViewModel">

  <!-- Usage inside a slide editor view:  <views:AudioPicker DataContext="{Binding Audio}"/> -->
  <StackPanel Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding HasAudio}">
      <!-- Rounded Text Badge (Auto-sized to text) -->
      <Border Height="40" CornerRadius="6" ClipToBounds="True"
              Background="#22000000" VerticalAlignment="Center">
        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" Margin="16,0" TextTrimming="CharacterEllipsis"/>
      </Border>

      <!-- Delete Button -->
      <Button Command="{Binding RemoveCommand}"
              Background="Transparent" Padding="6" VerticalAlignment="Center"
              ToolTip.Tip="Remove audio">
        <PathIcon Width="22" Height="22" Foreground="#FF6B6B"
                  Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
      </Button>
    </StackPanel>

    <!-- Teal "Choose Audio..." Button -->
    <Button Content="Choose Audio..."
            Command="{Binding ChooseCommand}"
            Background="{DynamicResource AccentTealBrush}"
            Foreground="White"
            FontWeight="SemiBold"
            FontSize="15"
            CornerRadius="10"
            Padding="18,10"
            HorizontalAlignment="Left"/>
  </StackPanel>
</UserControl>
