<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FactForge.ViewModels"
             xmlns:d="http://schemas.com/expression/blend/2008"
             xmlns:svg="using:Avalonia.Svg.Skia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:FactForge.Controls"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="FactForge.Views.ResultsView"
             x:DataType="vm:ResultsViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="24" RowDefinitions="Auto,*">

        <!-- Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Border BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,5" Padding="0,0,0,20">
                <Grid>
                    <!-- Title in the absolute center across full header width -->
                    <TextBlock Text="{Binding QuizTitle, StringFormat='Results — {0}'}" 
                               FontSize="32" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource PrimaryTextBrush}" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>

                    <!-- Left and Right Controls -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Back Button -->
                        <Button Grid.Column="0" Command="{Binding BackCommand}" 
                                Background="{DynamicResource CardBackgroundBrush}" 
                                Foreground="{DynamicResource AccentTealBrush}" 
                                CornerRadius="20" Padding="6,6,16,6" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Teal Circular Icon Container -->
                                <Border Background="{DynamicResource AccentTealBrush}" CornerRadius="15" Width="30" Height="30">
                                    <PathIcon Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                                </Border>

                                <TextBlock Text="Back" VerticalAlignment="Center" FontSize="15"/>
                            </StackPanel>
                        </Button>

                        <!-- Menu Button -->
                        <Button Grid.Column="2" Background="Transparent" Padding="8" 
                                Command="{Binding OpenMenuCommand}" ToolTip.Tip="Menu">
                            <PathIcon Width="40" Height="40" Foreground="{DynamicResource PrimaryTextBrush}" 
                                      Data="M3 6h18v2H3zM3 11h18v2H3zM3 16h18v2H3z"/>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Sessions Scrollable List -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="16"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionResultViewModel">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="16" Padding="20">
                            <StackPanel Spacing="16">
                                
                                <!-- Session Header Info -->
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding StartedAt, StringFormat='{}{0:g}'}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" IsVisible="{Binding !IsComplete}">
                                        <TextBlock Text="In Progress" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Score History Graph -->
                                <Border Background="{DynamicResource CardSecondaryBrush}"
                                        CornerRadius="12"
                                        Padding="16"
                                        IsVisible="{Binding ScoreHistory.Count}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Score Progress"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <controls:ScoreHistoryChart
                                            Series="{Binding ScoreHistory}"
                                            Height="280" />
                                    </StackPanel>
                                </Border>

                                <!-- Players List Container -->
                                <Border Background="{DynamicResource CardSecondaryBrush}" CornerRadius="12" Padding="16">
                                    <ItemsControl ItemsSource="{Binding Players}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PlayerResultViewModel">
                                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Score, StringFormat='{} {0} pts'}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentTealBrush}" Margin="24,0" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding CorrectCount, StringFormat='{}{0} correct'}" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </Grid>
</UserControl>