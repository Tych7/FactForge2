<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FactForge.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="FactForge.Views.EditorView"
             x:DataType="vm:EditorViewModel">

    <Grid Margin="24" RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,16">
            <Button Grid.Column="0" Content="← Back" Command="{Binding BackCommand}" Margin="0,0,12,0"/>
            <TextBox Grid.Column="1" Text="{Binding Title}" FontSize="22" FontWeight="Bold" Watermark="Quiz title"/>
            <Button Grid.Column="2" Content="Save Title" Command="{Binding SaveTitleCommand}" Margin="12,0,0,0"/>
            <Button Grid.Column="3" Content="Present ▶" Classes="accent" Command="{Binding PresentCommand}" Margin="12,0,0,0"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="280,16,*">

            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">
                    <TextBlock Text="Add slide" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Spacing="4">
                        <Button Content="+ Text" HorizontalAlignment="Stretch" Command="{Binding AddTextSlideCommand}"/>
                        <Button Content="+ Multiple Choice" HorizontalAlignment="Stretch"
                                Command="{Binding AddMultipleChoiceSlideCommand}"/>
                        <Button Content="+ Open Question" HorizontalAlignment="Stretch"
                                Command="{Binding AddOpenQuestionSlideCommand}"/>
                        <Button Content="+ Leaderboard" HorizontalAlignment="Stretch"
                                Command="{Binding AddLeaderboardSlideCommand}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        CornerRadius="8">
                    <ListBox ItemsSource="{Binding Slides}" SelectedItem="{Binding SelectedSlide}"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SlideListItemViewModel">
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="11" Opacity="0.6"/>
                                    <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
                    <Button Content="↑" Command="{Binding MoveSlideUpCommand}"/>
                    <Button Content="↓" Command="{Binding MoveSlideDownCommand}"/>
                    <Button Content="Delete" Command="{Binding DeleteSlideCommand}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Column="2" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8" Padding="24">
                <ContentControl Content="{Binding CurrentSlideEditor}"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"/>
            </Border>

        </Grid>
    </Grid>
</UserControl>
