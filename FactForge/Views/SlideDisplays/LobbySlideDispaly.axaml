<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FactForge.ViewModels"
             xmlns:models="using:FactForge.Models"
             xmlns:conv="using:FactForge.Converters"
             xmlns:d="http://schemas.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="700"
             x:Class="FactForge.Views.SlideDisplays.LobbySlideDisplay"
             x:DataType="vm:PresentViewModel">

    <Grid ColumnDefinitions="*,*">
        <!-- Left Column: QR Code, Join URL, Code, and Start Button -->
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="16">
                <Image Source="{Binding QrImage}" Width="260" Height="260"/>
            </Border>
            
            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding JoinUrl}" HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="{Binding JoinCode}" HorizontalAlignment="Center" FontSize="44" FontWeight="Bold" LetterSpacing="2" Foreground="{DynamicResource PrimaryTextBrush}"/>
            </StackPanel>

            <Button Content="Start Quiz ▶" 
                    HorizontalAlignment="Center" 
                    FontSize="18"
                    FontWeight="SemiBold"
                    Background="{DynamicResource AccentTealBrush}" 
                    Foreground="White"
                    CornerRadius="25" 
                    Padding="32,12" 
                    Command="{Binding StartQuizCommand}"/>
        </StackPanel>

        <!-- Right Column: Joined Players Grid/Badges -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="24,32,32,32">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="Joined Players" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <Border Background="{DynamicResource AccentTealBrush}" CornerRadius="12" Padding="10,2,10,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Players.Count}" FontSize="14" FontWeight="Bold" Foreground="White"/>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Players}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PlayerInfoDto">
                                <Border Margin="8" 
                                        Padding="14,10,20,10" 
                                        Background="{DynamicResource SecondaryBackgroundBrush}" 
                                        CornerRadius="26"
                                        BoxShadow="0 3 8 0 #15000000">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        
                                        <!-- Larger Avatar Bubble -->
                                        <Border Width="42" Height="42" CornerRadius="21" 
                                                Background="{Binding Name, Converter={x:Static conv:PlayerColorConverter.Instance}}">
                                            <TextBlock Text="{Binding Name[0]}" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" 
                                                       FontWeight="Bold" 
                                                       Foreground="White" 
                                                       FontSize="20"/>
                                        </Border>
                                        
                                        <!-- Larger Player Name Text -->
                                        <TextBlock Text="{Binding Name}" 
                                                   VerticalAlignment="Center" 
                                                   FontSize="18" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>