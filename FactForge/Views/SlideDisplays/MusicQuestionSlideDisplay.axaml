<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FactForge.ViewModels"
             xmlns:controls="using:FactForge.Controls"
             x:Class="FactForge.Views.SlideDisplays.MusicQuestionSlideDisplay"
             x:DataType="vm:SlideDisplay"
             IsVisible="{Binding IsMusicQuestion}">
  <Viewbox Stretch="Uniform" StretchDirection="Both" Margin="24">
    <Grid RowDefinitions="Auto,*" Width="1200" Height="700">
      
      <!-- Header (Row 0) -->
      <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,32">
        <TextBlock Text="Guess the song!" FontSize="44" FontWeight="Bold" 
                   Foreground="{DynamicResource PrimaryTextBrush}" 
                   HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- Content Area (Row 1 - Both the Revealed Card and Music Player share this exact spot) -->
      <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="1100">
        
        <!-- Revealed State Card (Appears when IsMusicRevealed is true) -->
        <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding IsMusicRevealed}">
          
          <!-- Correct Answer Pill Badge -->
          <Border Background="Transparent" BorderBrush="#2ECC71" BorderThickness="1.5" 
                  CornerRadius="16" Padding="16,6" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Background="#2ECC71" CornerRadius="10" Width="20" Height="20">
                <PathIcon Width="10" Height="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
              </Border>
              <TextBlock Text="Correct Answer" Foreground="#2ECC71" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- Main Answer Card with Green Border -->
          <Border Background="{DynamicResource CardBackgroundBrush}" 
                  BorderBrush="#2ECC71" 
                  BorderThickness="2" CornerRadius="20" Padding="48,40"
                  HorizontalAlignment="Center">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
              <TextBlock Text="{Binding MusicArtistDisplay}" FontSize="28" 
                         Foreground="{DynamicResource AccentTealBrush}" 
                         HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding MusicTitle}" FontSize="48" FontWeight="Bold" 
                         Foreground="{DynamicResource PrimaryTextBrush}" 
                         HorizontalAlignment="Center"/>
            </StackPanel>
          </Border>
          
        </StackPanel>

        <!-- Music Player Card (Disappears when IsMusicRevealed is true) -->
        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="20" Padding="28"
                IsVisible="{Binding IsMusicRevealed, Converter={x:Static BoolConverters.Not}}">
          <StackPanel Spacing="16">
            
            <!-- Time to Answer & Responses Labels -->
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Time to answer:" 
                         Foreground="{DynamicResource SecondaryTextBrush}" 
                         VerticalAlignment="Center" FontSize="16"/>
              <TextBlock Grid.Column="1" Text="{Binding StatusText}" 
                         Foreground="{DynamicResource SecondaryTextBrush}" 
                         VerticalAlignment="Center" FontSize="16"/>
            </Grid>

            <!-- Time to Answer Progress Bar -->
            <ProgressBar Minimum="0" Maximum="{Binding TimeSeconds}" 
                         Value="{Binding SecondsRemaining}" Height="12" 
                         CornerRadius="6"
                         Foreground="{DynamicResource AccentTealBrush}"/>

            <!-- Inner Audio Player Card -->
            <Border Background="{DynamicResource CardSecondaryBrush}" CornerRadius="14" Padding="20,16" Margin="0,4,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20" VerticalAlignment="Center">
                
                <!-- Replay Circular Button -->
                <Button Grid.Column="0" Command="{Binding ReplayMusicCommand}" 
                        Background="{DynamicResource AppBackgroundBrush}" 
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Width="48" Height="48" CornerRadius="24" Padding="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                  <PathIcon Width="18" Height="18" Foreground="{DynamicResource AccentTealBrush}" 
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Data="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/>
                </Button>
                
                <!-- Music Track Progress Bar -->
                <controls:WaveformProgressBar
                    Grid.Column="1"
                    Peaks="{Binding MusicWaveformPeaks}"
                    PositionSeconds="{Binding MusicPositionSeconds}"
                    DurationSeconds="{Binding MusicDurationSeconds}"
                    PlayedBrush="{DynamicResource AccentTealBrush}"
                    UnplayedBrush="{DynamicResource SecondaryTextBrush}"
                    Height="40"
                    VerticalAlignment="Center"/>
                
                <!-- Music Time Text -->
                <TextBlock Grid.Column="2" Text="{Binding MusicTimeText}" 
                    VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                    Foreground="{DynamicResource PrimaryTextBrush}"/>
              </Grid>
            </Border>
            
          </StackPanel>
        </Border>

      </Grid>
    </Grid>
  </Viewbox>
</UserControl>