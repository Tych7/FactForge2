<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FactForge.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svg="using:Avalonia.Svg.Skia"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="FactForge.Views.StartView"
             x:DataType="vm:StartViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

    <Viewbox Stretch="Uniform" Margin="60">
        <StackPanel HorizontalAlignment="Center" Spacing="40">
            <!-- Big Logo -->
            <Image MaxHeight="500" Stretch="Uniform">
                <Image.Source>
                    <svg:SvgImage Source="avares://FactForge/Assets/bigLogo.svg"/>
                </Image.Source>
            </Image>

            <!-- Play Button -->
            <Button Content="Play ►" 
                    HorizontalAlignment="Center"
                    FontSize="18" 
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="{DynamicResource AccentTealBrush}"
                    CornerRadius="20"
                    Padding="36,10" 
                    Command="{Binding PlayCommand}"/>
        </StackPanel>
    </Viewbox>
</UserControl>
