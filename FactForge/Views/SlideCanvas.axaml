<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FactForge.ViewModels"
             xmlns:convb="using:Avalonia.Data.Converters"
             x:Class="FactForge.Views.SlideCanvas"
             x:DataType="vm:SlideDisplay">

  <UserControl.Styles>
    <Style Selector="Border.optionTile">
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Border.optionTile.correct">
      <Setter Property="BorderBrush" Value="White"/>
      <Setter Property="BorderThickness" Value="5"/>
    </Style>
  </UserControl.Styles>

    <!-- Column widths come from SlideDisplay: 3*/2* with an image, * / 0 without. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding ContentColumnWidth}"/>
      <ColumnDefinition Width="{Binding ImageColumnWidth}"/>
    </Grid.ColumnDefinitions>


    <!-- Image, right -->
    <Border Grid.Column="1" IsVisible="{Binding HasImage}"
            Margin="0,24,24,24" CornerRadius="12" ClipToBounds="True">
      <Image Source="{Binding Image}" Stretch="Uniform"
             HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>

    <!-- All slide content in the left column -->
    <Panel Grid.Column="0">

      <!-- Text slide -->
      <StackPanel IsVisible="{Binding IsText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Spacing="16" MaxWidth="900" Margin="24">
        <Viewbox StretchDirection="DownOnly">
          <TextBlock Text="{Binding Header}" FontSize="42" FontWeight="Bold"
                     HorizontalAlignment="Center" TextWrapping="NoWrap"/>
        </Viewbox>
        <Viewbox StretchDirection="DownOnly">
          <TextBlock Text="{Binding SubText}" FontSize="20" Opacity="0.8"
                     HorizontalAlignment="Center" TextWrapping="NoWrap"/>
        </Viewbox>
      </StackPanel>

      <!-- Multiple choice: question + timer pinned to the top, tiles fill the rest -->
      <Grid IsVisible="{Binding IsMultipleChoice}" RowDefinitions="Auto,Auto,*" Margin="24">
        <Viewbox Grid.Row="0" StretchDirection="DownOnly" Margin="0,0,0,12">
          <TextBlock Text="{Binding Question}" FontSize="40" FontWeight="Bold"
                     HorizontalAlignment="Center" TextWrapping="NoWrap"/>
        </Viewbox>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <ProgressBar Grid.Column="0" Minimum="0" Maximum="{Binding TimeSeconds}"
                       Value="{Binding SecondsRemaining}" Height="10"/>
          <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding StatusText}"/>
        </Grid>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Options}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AnswerOptionDisplay">
              <Border Classes="optionTile" Classes.correct="{Binding IsCorrect}"
                      Background="{Binding Background}"
                      Margin="6" Padding="16" CornerRadius="8">
                <Viewbox StretchDirection="DownOnly">
                  <TextBlock Text="{Binding Text}" FontSize="48" FontWeight="SemiBold"
                             Foreground="White" TextWrapping="NoWrap" TextAlignment="Center"/>
                </Viewbox>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <!-- Open question: no tiles, so question + timer are centered -->
      <Grid IsVisible="{Binding IsOpenQuestion}" RowDefinitions="*,Auto,Auto,Auto,*" Margin="24">
        <Viewbox Grid.Row="1" StretchDirection="DownOnly" Margin="0,0,0,16">
          <TextBlock Text="{Binding Question}" FontSize="44" FontWeight="Bold"
                     HorizontalAlignment="Center" TextWrapping="NoWrap"/>
        </Viewbox>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
          <ProgressBar Grid.Column="0" Minimum="0" Maximum="{Binding TimeSeconds}"
                       Value="{Binding SecondsRemaining}" Height="10"/>
          <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding StatusText}"/>
        </Grid>

        <!-- Correct answer, shown once the slide is revealed -->
        <Viewbox Grid.Row="3" StretchDirection="DownOnly"
                 IsVisible="{Binding CorrectAnswer, Converter={x:Static convb:StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding CorrectAnswer, StringFormat='Correct answer: {0}'}"
                     FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="NoWrap"/>
        </Viewbox>
      </Grid>

      <!-- Music question -->
      <Grid IsVisible="{Binding IsMusicQuestion}"
            RowDefinitions="*,Auto,*"
            Margin="24">

        <!-- Question / revealed answer -->
        <StackPanel Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="12">

          <TextBlock Text="Guess the song!"
                    FontSize="44"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"/>

          <StackPanel IsVisible="{Binding IsMusicRevealed}"
                      HorizontalAlignment="Center"
                      Spacing="4">

            <TextBlock Text="{Binding MusicTitle}"
                      FontSize="32"
                      FontWeight="SemiBold"
                      HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding MusicArtistDisplay}"
                      FontSize="24"
                      Opacity="0.8"
                      HorizontalAlignment="Center"/>
          </StackPanel>

        </StackPanel>

        <!-- Progress bars -->
        <StackPanel Grid.Row="1"
                    Spacing="14"
                    Margin="0,16,0,16">

            <!-- Answer timer -->
            <Grid ColumnDefinitions="*,Auto">

                <ProgressBar Grid.Column="0"
                            Minimum="0"
                            Maximum="{Binding TimeSeconds}"
                            Value="{Binding SecondsRemaining}"
                            Height="10"/>

                <TextBlock Grid.Column="1"
                          Margin="12,0,0,0"
                          Text="{Binding StatusText}"/>

            </Grid>

            <!-- Music progress -->
            <Grid ColumnDefinitions="*,Auto"
                  Margin="0,50,0,16">

                <ProgressBar Grid.Column="0"
                            Minimum="0"
                            Maximum="{Binding MusicDurationSeconds}"
                            Value="{Binding MusicPositionSeconds}"
                            Height="5"
                            VerticalAlignment="Center"
                            Foreground="#5BC0EB"/>

                <TextBlock Grid.Column="1"
                          Margin="12,0,0,0"
                          Text="{Binding MusicTimeText}"
                          VerticalAlignment="Center"
                          FontSize="16"
                          Opacity="0.8"/>

            </Grid>

            <Button Content="Replay"
                    Command="{Binding ReplayMusicCommand}"
                    HorizontalAlignment="Center"
                    Padding="24,10"
                    FontSize="18"/>
                        
        </StackPanel>

      </Grid>

      <!-- Leaderboard placeholder (editor preview). The live leaderboard list stays in PresentView. -->
      <TextBlock IsVisible="{Binding IsLeaderboard}" Text="Leaderboard" FontSize="36" FontWeight="Bold"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>

    </Panel>
  </Grid>
</UserControl>
