<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FactForge.ViewModels"
             xmlns:views="using:FactForge.Views"
             xmlns:models="using:FactForge.Models"
             xmlns:slideDisplay="using:FactForge.Views.SlideDisplays"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="FactForge.Views.PresentView"
             x:DataType="vm:PresentViewModel"
             x:Name="PresentRoot">

    <Grid Margin="24" RowDefinitions="Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
            <Button Grid.Column="0" Content="← Back" Command="{Binding BackCommand}"/>
            <TextBlock Grid.Column="1" Text="{Binding QuizTitle}" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding SlideNumber}" Opacity="0.6"/>
        </Grid>

        <!-- Lobby: QR + join code + waiting players -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" IsVisible="{Binding Phase, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Lobby}">
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <Image Source="{Binding QrImage}" Width="280" Height="280"/>
                <TextBlock Text="{Binding JoinUrl}" HorizontalAlignment="Center" FontSize="14" Opacity="0.7"/>
                <TextBlock Text="{Binding JoinCode}" HorizontalAlignment="Center" FontSize="40" FontWeight="Bold"/>
                <Button Content="Start Quiz ▶" Classes="accent" HorizontalAlignment="Center" FontSize="18"
                        Padding="24,10" Command="{Binding StartQuizCommand}"/>
            </StackPanel>

            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="24,0,0,0">
                <TextBlock Grid.Row="0" Text="{Binding Players.Count, StringFormat='Players joined: {0}'}"
                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        CornerRadius="8" Padding="12">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Players}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:PlayerInfoDto">
                                    <TextBlock Text="{Binding Name}" Padding="4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Active Slide View (Merged from SlideCanvas) -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" IsVisible="{Binding IsSlideVisible}">
            
            <!-- Slide Content & Image Layout (Bound to SlideDisplay via DataContext) -->
            <Grid Grid.Row="0" DataContext="{Binding Slide}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ContentColumnWidth}"/>
                    <ColumnDefinition Width="{Binding ImageColumnWidth}"/>
                </Grid.ColumnDefinitions>

                <!-- Image, right -->
                <Border Grid.Column="1" IsVisible="{Binding HasImage}"
                        Margin="0,24,24,24" CornerRadius="12" ClipToBounds="True">
                    <Image Source="{Binding Image}" Stretch="Uniform"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Slide Content Types -->
                <Panel Grid.Column="0">
                    <slideDisplay:TextSlideDisplay/>
                    <slideDisplay:MultipleChoiceSlideDisplay/>
                    <slideDisplay:OpenQuestionSlideDisplay/>
                    <slideDisplay:MusicQuestionSlideDisplay/>
                    <slideDisplay:LeaderboardSlideDisplay/>
                </Panel>
            </Grid>

            <!-- Next Button (Bound to PresentViewModel using RelativeSource) -->
            <Button Grid.Row="1" Content="Next ▶" Classes="accent" HorizontalAlignment="Center" Margin="0,16,0,0"
                    FontSize="16" Padding="20,8" 
                    Command="{Binding #PresentRoot.((vm:PresentViewModel)DataContext).NextCommand}"/>
        </Grid>

        <!-- Leaderboard slide, shown between the reveal and the next question -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto"
              IsVisible="{Binding Phase, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Leaderboard}">
            <TextBlock Text="Leaderboard" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
            <views:LeaderboardChart Grid.Row="1" Items="{Binding Leaderboard}" Margin="0,16"/>
            <Button Grid.Row="2" Content="Next ▶" Classes="accent" HorizontalAlignment="Center" Margin="0,16,0,0"
                    FontSize="16" Padding="20,8" Command="{Binding NextCommand}"/>
        </Grid>

        <!-- Finished -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto"
              IsVisible="{Binding Phase, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Finished}">
            <TextBlock Text="Quiz complete" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
            <views:LeaderboardChart Grid.Row="1" Items="{Binding Leaderboard}" Margin="0,16"/>
            <Button Grid.Row="2" Content="Back to Library" Classes="accent" HorizontalAlignment="Center" Margin="0,16,0,0"
                    Command="{Binding BackCommand}"/>
        </Grid>

    </Grid>
</UserControl>
