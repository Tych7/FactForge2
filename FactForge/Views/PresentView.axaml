<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FactForge.ViewModels.Presentation"
             xmlns:views="using:FactForge.Views"
             xmlns:models="using:FactForge.Models"
             xmlns:slideDisplay="using:FactForge.Views.SlideDisplays"
             xmlns:svg="using:Avalonia.Svg.Skia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="FactForge.Views.PresentView"
             x:DataType="vm:PresentViewModel"
             x:Name="PresentRoot"
             Background="{DynamicResource AppBackgroundBrush}">

    <Grid Margin="24" RowDefinitions="Auto,*">

        <!-- Top Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Border BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,5" Padding="0,0,0,16">
                <Grid>
                    <!-- Centered Quiz Title (Absolute Center) -->
                    <TextBlock Text="{Binding QuizTitle}" FontSize="26" FontWeight="Bold" 
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <!-- Left Header Buttons -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">

                                <!-- Exit Button -->
                                <Button Command="{Binding BackCommand}"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        Foreground="{DynamicResource AccentTealBrush}"
                                        CornerRadius="20"
                                        Padding="6,6,16,6"
                                        FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{DynamicResource AccentTealBrush}"
                                                CornerRadius="15"
                                                Width="30"
                                                Height="30">
                                            <PathIcon Width="14"
                                                    Height="14"
                                                    Foreground="White"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                                        </Border>
                                        <TextBlock Text="Exit"
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                Foreground="{DynamicResource AccentTealBrush}"/>
                                    </StackPanel>
                                </Button>

                                <!-- Rejoin QR Button -->
                                <Button Command="{Binding ShowRejoinQrCommand}"
                                        Width="44"
                                        Height="44"
                                        Padding="0"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        Foreground="{DynamicResource AccentTealBrush}"
                                        CornerRadius="22"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        ToolTip.Tip="Show rejoin QR code">

                                    <PathIcon Width="22"
                                            Height="22"
                                            Foreground="{DynamicResource AccentTealBrush}"
                                            Data="M10.75,15 C11.9926407,15 13,16.0073593 13,17.25 L13,22.75 C13,23.9926407 11.9926407,25 10.75,25 L5.25,25 C4.00735931,25 3,23.9926407 3,22.75 L3,17.25 C3,16.0073593 4.00735931,15 5.25,15 L10.75,15 Z M18.3346843,15 L18.3346843,18.3333333 L21.6671089,18.3333333 L21.6671089,21.6666667 L18.3346843,21.6660851 L18.3346843,24.9994184 L15.0013509,24.9994184 L15.0013509,21.6660851 L18.3337756,21.6666667 L18.3337756,18.3333333 L15.0013509,18.3333333 L15.0013509,15 L18.3346843,15 Z M25.0004423,21.6660851 L25.0004423,24.9994184 L21.6671089,24.9994184 L21.6671089,21.6660851 L25.0004423,21.6660851 Z M10.75,16.5 L5.25,16.5 C4.83578644,16.5 4.5,16.8357864 4.5,17.25 L4.5,22.75 C4.5,23.1642136 4.83578644,23.5 5.25,23.5 L10.75,23.5 C11.1642136,23.5 11.5,23.1642136 11.5,22.75 L11.5,17.25 C11.5,16.8357864 11.1642136,16.5 10.75,16.5 Z M9.5,18.5 L9.5,21.5 L6.5,21.5 L6.5,18.5 L9.5,18.5 Z M25.0004423,15 L25.0004423,18.3333333 L21.6671089,18.3333333 L21.6671089,15 L25.0004423,15 Z M10.75,3 C11.9926407,3 13,4.00735931 13,5.25 L13,10.75 C13,11.9926407 11.9926407,13 10.75,13 L5.25,13 C4.00735931,13 3,11.9926407 3,10.75 L3,5.25 C3,4.00735931 4.00735931,3 5.25,3 L10.75,3 Z M22.75,3 C23.9926407,3 25,4.00735931 25,5.25 L25,10.75 C25,11.9926407 23.9926407,13 22.75,13 L17.25,13 C16.0073593,13 15,11.9926407 15,10.75 L15,5.25 C15,4.00735931 16.0073593,3 17.25,3 L22.75,3 Z M10.75,4.5 L5.25,4.5 C4.83578644,4.5 4.5,4.83578644 4.5,5.25 L4.5,10.75 C4.5,11.1642136 4.83578644,11.5 5.25,11.5 L10.75,11.5 C11.1642136,11.5 11.5,11.1642136 11.5,10.75 L11.5,5.25 C11.5,4.83578644 11.1642136,4.5 10.75,4.5 Z M22.75,4.5 L17.25,4.5 C16.8357864,4.5 16.5,4.83578644 16.5,5.25 L16.5,10.75 C16.5,11.1642136 16.8357864,11.5 17.25,11.5 L22.75,11.5 C23.1642136,11.5 23.5,11.1642136 23.5,10.75 L23.5,5.25 C23.5,4.83578644 23.1642136,4.5 22.75,4.5 Z M9.5,6.5 L9.5,9.5 L6.5,9.5 L6.5,6.5 L9.5,6.5 Z M21.5,6.5 L21.5,9.5 L18.5,9.5 L18.5,6.5 L21.5,6.5 Z"/>
                                </Button>

                            </StackPanel>


                    <!-- Right Logo -->
                    <Image Height="70" HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="Uniform">
                        <Image.Source>
                            <svg:SvgImage Source="avares://FactForge/Assets/horizontalLogo.svg"/>
                        </Image.Source>
                    </Image>
                </Grid>
            </Border>
        </Grid>


        <!-- Lobby: QR + join code + waiting players -->
        <slideDisplay:LobbySlideDisplay Grid.Row="1" IsVisible="{Binding Phase, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Lobby}"/>

        <!-- Active Slide View -->
        <Grid Grid.Row="1" RowDefinitions="*,Auto" IsVisible="{Binding IsSlideVisible}">
            
            <!-- Slide Content & Image Layout -->
            <Grid Grid.Row="0" DataContext="{Binding Slide}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ContentColumnWidth}"/>
                    <ColumnDefinition Width="{Binding ImageColumnWidth}"/>
                </Grid.ColumnDefinitions>

                <!-- Image, right filling the column width but wrapping tightly around the image height -->
                <Border Grid.Column="1" IsVisible="{Binding HasImage}"
                        Background="{DynamicResource CardBackgroundBrush}"
                        Margin="0,24,24,24" Padding="16" CornerRadius="16" ClipToBounds="True"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Image Source="{Binding Image}" Stretch="Uniform"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Slide Content Types -->
                <Panel Grid.Column="0">
                    <slideDisplay:TextSlideDisplay/>
                    <slideDisplay:MultipleChoiceSlideDisplay/>
                    <slideDisplay:OpenQuestionSlideDisplay/>
                    <slideDisplay:MusicQuestionSlideDisplay/>
                    <slideDisplay:LeaderboardSlideDisplay/>
                </Panel>
            </Grid>

            <!-- Pill-styled Next Button -->
            <Button Grid.Row="1" Content="Next ▶" HorizontalAlignment="Center"
                    Background="{DynamicResource CardBackgroundBrush}" 
                    Foreground="{DynamicResource PrimaryTextBrush}" 
                    CornerRadius="20" FontSize="16" Padding="24,10" 
                    Command="{Binding #PresentRoot.((vm:PresentViewModel)DataContext).NextCommand}"/>
        </Grid>

        <!-- Leaderboard slide -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto"
              IsVisible="{Binding Phase, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Leaderboard}">
            <TextBlock Text="Leaderboard" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
            <views:LeaderboardChart Grid.Row="1" Items="{Binding Leaderboard}" Margin="0,16"/>
            <Button Grid.Row="2" Content="Next ▶" HorizontalAlignment="Center" Margin="0,16,0,0"
                    Background="{DynamicResource CardBackgroundBrush}" 
                    Foreground="{DynamicResource PrimaryTextBrush}" 
                    CornerRadius="20" FontSize="16" Padding="24,10" 
                    Command="{Binding NextCommand}"/>
        </Grid>

        <!-- Finished -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto"
              IsVisible="{Binding Phase, Converter={StaticResource EnumEqualityConverter}, ConverterParameter=Finished}">
            <TextBlock Text="Quiz complete" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center"/>
            <views:LeaderboardChart Grid.Row="1" Items="{Binding Leaderboard}" Margin="0,16"/>
            <Button Grid.Row="2" Content="Back to Library" HorizontalAlignment="Center" Margin="0,16,0,0"
                    Background="{DynamicResource CardBackgroundBrush}" 
                    Foreground="{DynamicResource PrimaryTextBrush}" 
                    CornerRadius="20" FontSize="16" Padding="24,10" 
                    Command="{Binding BackCommand}"/>
        </Grid>

    </Grid>
</UserControl>