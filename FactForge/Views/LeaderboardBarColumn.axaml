<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FactForge.ViewModels"
             x:Class="FactForge.Views.LeaderboardBarColumn"
             x:DataType="vm:LeaderboardBarItem"
             Width="96">

    <Grid RowDefinitions="*,Auto">
        <Panel x:Name="Plot" Grid.Row="0">
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Score}"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <Border x:Name="Bar"
                        Background="{Binding Fill}"
                        CornerRadius="10,10,0,0"
                        Height="0"/>
            </StackPanel>
        </Panel>
        <TextBlock Grid.Row="1"
                   Text="{Binding Name}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,10,0,0"/>
    </Grid>
</UserControl>
