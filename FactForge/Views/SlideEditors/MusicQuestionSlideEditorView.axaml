<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FactForge.ViewModels"
             xmlns:views="using:FactForge.Views"
             x:Class="FactForge.Views.MusicQuestionSlideEditorView"
             x:DataType="vm:MusicQuestionSlideEditorViewModel">

    <StackPanel Spacing="16">
        
        <!-- Header Section Title & Divider -->
        <Border BorderBrush="{DynamicResource CardHeaderBorderBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,12">
            <TextBlock Text="Music Question" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
        </Border>

        <!-- Song title Input -->
        <StackPanel Spacing="6">
            <TextBlock Text="Song title" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <TextBox Text="{Binding Title}"
                     Watermark="Correct song title"
                     Background="White" Foreground="#121921"
                     CornerRadius="12" Padding="12,8" FontSize="15"/>
        </StackPanel>

        <!-- Artist Inputs -->
        <StackPanel Spacing="6">
            <TextBlock Text="Artist" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <ItemsControl ItemsSource="{Binding Artists}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="0,0,0,6">

                            <TextBox Grid.Column="0"
                                     Text="{Binding Text}"
                                     Watermark="Correct artist"
                                     Background="White" Foreground="#121921"
                                     CornerRadius="12" Padding="12,8" FontSize="15"/>

                            <Button Grid.Column="1"
                                    Content="🗑"
                                    Margin="8,0,0,0"
                                    IsVisible="{Binding CanRemove}"
                                    Command="{Binding $parent[ItemsControl].DataContext.RemoveArtistCommand}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="+ Add artist"
                    HorizontalAlignment="Left"
                    Command="{Binding AddArtistCommand}"/>
        </StackPanel>

        <!-- Time limit Input -->
        <StackPanel Spacing="6">
            <TextBlock Text="Time limit (seconds)" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <NumericUpDown Value="{Binding TimeSeconds}"
                           Minimum="5"
                           Maximum="300"
                           Increment="5"/>
        </StackPanel>

        <!-- Audio Picker Section -->
        <StackPanel Spacing="6">
            <TextBlock Text="Audio" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <views:AudioPicker DataContext="{Binding Audio}"/>
        </StackPanel>

        <!-- Image Picker Section -->
        <StackPanel Spacing="6">
            <TextBlock Text="Image" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
            <views:ImagePicker DataContext="{Binding Image}"/>
        </StackPanel>
        
    </StackPanel>
</UserControl>