<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FactForge.Views.AppMenuDialog"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">

        <Grid Background="{DynamicResource DialogOverlayBrush}" PointerPressed="OnBackgroundPressed">
            <Border Background="{DynamicResource DialogBackgroundBrush}"
                    BorderBrush="#1E88E5"
                    BorderThickness="2"
                    CornerRadius="12"
                    Padding="32"
                    Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 24 0 #60000000">
                <StackPanel Spacing="16">
                    <TextBlock Text="Menu" FontSize="22" FontWeight="Bold"
                            Foreground="{DynamicResource DialogTitleBrush}"
                            HorizontalAlignment="Center"/>

                    <Button Content="Options" FontSize="16" Padding="0,12"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Click="OnOptions"/>

                    <Button Content="Exit" FontSize="16" Padding="0,12" Classes="accent"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Click="OnExit"/>
                </StackPanel>
            </Border>
        </Grid>
</Window>